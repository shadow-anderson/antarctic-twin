# ---------------------------------------------------------------
# .env.local.example — Antarctic Digital Twin (Frontend)
#
# HOW TO USE:
#   cp .env.local.example .env.local
#   then fill in the values for your environment.
#
# .env.local is git-ignored and must never be committed.
# This file (.env.local.example) IS committed and documents
# every variable the app needs.
# ---------------------------------------------------------------

# Base URL of the FastAPI backend.
# Local development: http://localhost:8000
# Production:        set via your deployment platform (Vercel / Railway / etc.)
NEXT_PUBLIC_API_URL=http://localhost:8000
